# Example environment configuration for MarkXIV
PORT=8080
# In-memory LRU capacity, in ENTRIES of uncompressed markdown (~66 KB each), so
# size this against available RAM. The compressed disk cache is the real cache.
MARKXIV_CACHE_CAP=128
MARKXIV_INDEX_MD=content/index.md
# MARKXIV_INDEX_HTML defaults to MARKXIV_INDEX_MD with .md swapped for .html
# MARKXIV_INDEX_HTML=content/index.html
MARKXIV_PANDOC_PATH=pandoc
MARKXIV_CACHE_DIR=./cache
MARKXIV_DISK_CACHE_CAP_BYTES=0
MARKXIV_SWEEP_INTERVAL_SECS=600
# Logs rotate daily; files are named markxiv.<YYYY-MM-DD>.log and the newest 14
# are kept. Tail the current day, e.g. logs/markxiv.$(date +%F).log
MARKXIV_LOG_DIR=./logs